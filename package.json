{
    "name": "sc-sedie",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "scripts": {
        "test": "jest --testPathPattern=tests/unit-tests/",
        "test-coverage": "jest --collect-coverage --testPathPattern=tests/unit-tests/",
        "integration-test": "jest tests/integration-tests/index.test.js --ci --reporters=default --reporters=jest-junit --testResultsProcessor=jest-junit --forceExit",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry https://npm.lumigame.com"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "chance": "^1.1.12",
        "random": "^3.0.6",
        "random-js": "^2.1.0",
        "sc-game-base": "4.1.0",
        "sc-instrument": "1.1.1",
        "prom-client": "^11.2.1"
    },
    "resolutions": {
        "sc-base-apis": "1.18.2",
        "sc-base-database": "1.11.1",
        "prom-client": "^11.2.1"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@babel/preset-env": "^7.25.3",
        "@babel/preset-typescript": "^7.24.7",
        "@commitlint/cli": "^19.4.0",
        "@commitlint/config-conventional": "^19.2.2",
        "@types/jest": "29.5.12",
        "babel-jest": "^29.7.0",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "^29.7.0",
        "jest-extended": "^4.0.2",
        "jest-junit": "^16.0.0",
        "jest-micro-auto-stub": "^1.0.9",
        "jest-sonar-reporter": "^2.0.0",
        "nodemon": "^3.1.4",
        "sc-game-service-integration-utils": "1.3.7"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
